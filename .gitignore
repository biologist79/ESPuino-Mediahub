# Local user configuration — copied from env-example, never commit.
# Keeping this out of git is what lets users edit their settings and still
# `git pull` updates without conflicts.
.env

# Optional local Docker Compose overrides (advanced users)
docker-compose.override.yml

/data/*
!/data/.gitkeep
/media/*
!/media/.gitkeep
__pycache__/
*.pyc

# Compiled translation catalogs — generated at Docker build time (or via
# `pybabel compile -d translations` for local dev), not committed.
translations/**/*.mo

# Nix results file
/result
