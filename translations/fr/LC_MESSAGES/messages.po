#, python-format
msgid "%(num)s card is printed and works here now."
msgid_plural "%(num)s cards are printed and work here now."
msgstr[0] "%(num)s carte est imprimée et fonctionne ici désormais."
msgstr[1] "%(num)s cartes sont imprimées et fonctionnent ici désormais."

#: app.py:788
#, python-format
msgid "This print project still has %(num)s card — delete it first."
msgid_plural "This print project still has %(num)s cards — delete them first."
msgstr[0] "Ce projet d'impression a encore %(num)s carte — supprimez-la d'abord."
msgstr[1] "Ce projet d'impression a encore %(num)s cartes — supprimez-les d'abord."

#: app.py:797
msgid "Print project deleted."
msgstr "Projet d'impression supprimé."

#: app.py:814
msgid "The cover must be a PNG, JPEG, WebP or GIF image."
msgstr "La couverture doit être une image PNG, JPEG, WebP ou GIF."

#: app.py:818
msgid "The uploaded cover could not be read."
msgstr "La couverture téléversée n'a pas pu être lue."

#: app.py:820
msgid "The uploaded cover is empty."
msgstr "La couverture téléversée est vide."

#: app.py:822
msgid "The uploaded cover is too large (limit is 10 MB)."
msgstr "La couverture téléversée est trop volumineuse (limite : 10 Mo)."

#: app.py:889
msgid "Please tick the ESPuinos this card should work on."
msgstr "Veuillez cocher les ESPuinos sur lesquels cette carte doit fonctionner."

#: app.py:898
msgid ""
"No cover found for this card — neither beside the media nor inside it. "
"Upload an image to print it with."
msgstr ""
"Aucune couverture trouvée pour cette carte — ni à côté des médias ni "
"dedans. Téléversez une image pour l'imprimer avec."

#: app.py:916
#, python-format
msgid "The card was not created at the print shop: %(error)s"
msgstr "La carte n'a pas été créée dans la boutique d'impression : %(error)s"

