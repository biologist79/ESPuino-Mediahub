msgid "Please choose a valid play mode."
msgstr "Veuillez choisir un mode de lecture valide."

#: app.py:572
msgid "This play mode only supports a single episode — please select just one."
msgstr ""
"Ce mode de lecture ne prend en charge qu'un seul épisode — veuillez n'en "
"sélectionner qu'un."

