msgid "Card ID must be exactly 12 digits."
msgstr "L'ID de la carte doit comporter exactement 12 chiffres."

#: app.py:372
msgid "Please choose a known ESPuino."
msgstr "Veuillez choisir un ESPuino connu."

#: app.py:381 app.py:401
#, python-format
msgid "Card %(id)s is already assigned on this ESPuino — opening it for editing."
msgstr ""
"La carte %(id)s est déjà assignée sur cet ESPuino — ouverture pour "
"modification."

#: app.py:395
msgid "Please choose a different, known ESPuino."
msgstr "Veuillez choisir un autre ESPuino connu."

