msgstr "Actualisation forcée déclenchée pour la carte %(id)s."

#: app.py:799
#, python-format
msgid "Force refresh triggered for all %(num)s cards."
msgstr "Actualisation forcée déclenchée pour les %(num)s cartes."

#: app.py:818
#, python-format
msgid ""
"Secure delete: ESPuino (%(esp_id)s) did not confirm the deletion. Card "
"was kept, please retry."
msgstr ""
"Suppression sécurisée : l'ESPuino (%(esp_id)s) n'a pas confirmé la "
"suppression. La carte a été conservée, veuillez réessayer."

#: app.py:834
#, python-format
msgid "Card %(id)s deleted (%(mode)s)."
msgstr "Carte %(id)s supprimée (%(mode)s)."

#: app.py:955
msgid "Recursion depth must be between 0 and 20."
msgstr "La profondeur de récursion doit être comprise entre 0 et 20."

#: app.py:966
msgid "The episode check interval must be between 0 and 10080 minutes (one week)."
msgstr ""
"L'intervalle de vérification doit être compris entre 0 et 10080 minutes "
