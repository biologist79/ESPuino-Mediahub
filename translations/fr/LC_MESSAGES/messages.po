#, python-format
msgid "Card %(id)s duplicated to %(esp_id)s."
msgstr "Carte %(id)s dupliquée sur %(esp_id)s."

#: app.py:440
msgid "A stream URL is required for webradio."
msgstr "Une URL de flux est requise pour la webradio."

#: app.py:448
msgid "Please choose a valid play mode."
msgstr "Veuillez choisir un mode de lecture valide."

#: app.py:466
#, python-format
msgid ""
"Some selected files could not be used (missing, or not readable by the "
"container's user) and were skipped: %(paths)s"
msgstr ""
"Certains fichiers sélectionnés n'ont pas pu être utilisés (absents ou non"
" lisibles par l'utilisateur du conteneur) et ont été ignorés : %(paths)s"

#: app.py:473
msgid "At least one audio file is required."
msgstr "Au moins un fichier audio est requis."

#: app.py:478
msgid "This play mode only supports a single file — please select just one."
msgstr ""
"Ce mode de lecture ne prend en charge qu'un seul fichier — veuillez n'en "
"sélectionner qu'un."

#: app.py:491
#, python-format
msgid ""
"This play mode plays a single folder, but the selected files lie in "
"%(num)s different ones. Choose a recursive play mode, or pick files from "
"one folder only."
msgstr ""
"Ce mode de lecture ne lit qu'un seul dossier, mais les fichiers "
"sélectionnés se trouvent dans %(num)s dossiers différents. Choisissez un "
"mode de lecture récursif, ou ne sélectionnez que des fichiers d'un seul "
"dossier."

#: app.py:545
#, python-format
msgid "Card %(id)s assigned."
msgstr "Carte %(id)s assignée."

#: app.py:548
#, python-format
msgid "Card %(id)s assigned on %(num)s ESPuinos."
msgstr "Carte %(id)s attribuée sur %(num)s ESPuinos."

