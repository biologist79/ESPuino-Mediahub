msgstr "Force Refresh für alle %(num)s Karten ausgelöst."

#: app.py:818
#, python-format
msgid ""
"Secure delete: ESPuino (%(esp_id)s) did not confirm the deletion. Card "
"was kept, please retry."
msgstr ""
"Secure Delete: Der ESPuino (%(esp_id)s) hat das Löschen nicht bestätigt. "
"Die Karte wurde beibehalten, bitte erneut versuchen."

#: app.py:834
#, python-format
msgid "Card %(id)s deleted (%(mode)s)."
msgstr "Karte %(id)s gelöscht (%(mode)s)."

#: app.py:955
msgid "Recursion depth must be between 0 and 20."
msgstr "Die Rekursionstiefe muss zwischen 0 und 20 liegen."

#: app.py:966
msgid "The episode check interval must be between 0 and 10080 minutes (one week)."
msgstr "Das Prüfintervall muss zwischen 0 und 10080 Minuten (einer Woche) liegen."

#: app.py:978
msgid "The cache limit must be between 0 and 1048576 MB."
msgstr "Das Cache-Limit muss zwischen 0 und 1048576 MB liegen."

