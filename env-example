# Your mediahub settings. Copy this file to .env and edit then
MEDIAHUB_TAG=latest         # image version: latest = main branch, or a sha-... tag to pin/roll back
MEDIAHUB_PORT=8080          # port where mediahub runs
MEDIAHUB_DATA=./data        # Mediahub's database directory
MEDIAHUB_MEDIA=./media      # where your audiofiles live
# Card-printing service (optional). Set this to your ESPuino label-printer and the
# hub places one order there per print project, and links you to it. It has to be
# reachable from this host *and* from your browser, so use a host/IP:port - not a
# container name. Empty = no print shop.
MEDIAHUB_PRINTER_URL=
MEDIAHUB_NAME=espuino-mediahub  # container name, e.g. for `docker logs <name>`
MEDIAHUB_UID=33             # user Mediahub runs with
MEDIAHUB_GID=33             # group Mediahub runs with
TZ=Europe/Berlin            # Your timezone